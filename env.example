# FXSentinel Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# OpenAI API Key (for AI analysis)
OPENAI_API_KEY=your_openai_api_key_here

# Finnhub API Key (for market data) - DISABLED
FINNHUB_API_KEY=your_finnhub_api_key_here

# Free Economic Calendar API Keys
FMP_API_KEY=your_fmp_api_key_here
FRED_API_KEY=your_fred_api_key_here

# Alpha Vantage API Keys (for forex data)
ALPHA_VANTAGE_API_KEY_1=your_alpha_vantage_key_1_here
ALPHA_VANTAGE_API_KEY_2=your_alpha_vantage_key_2_here
ALPHA_VANTAGE_API_KEY_3=your_alpha_vantage_key_3_here
ALPHA_VANTAGE_API_KEY_4=your_alpha_vantage_key_4_here

# Unirate API Key (for exchange rates)
UNIRATE_API_KEY=your_unirate_api_key_here

# Polygon.io API Key (for market data)
POLYGON_API_KEY=your_polygon_api_key_here

# Telegram Bot Configuration (for alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=@FXSentinelBot

# Firebase Configuration (Backend - for alert storage)
FIREBASE_PROJECT_ID=fxsentinel
FIREBASE_REALTIME_URL=https://fxsentinel-default-rtdb.firebaseio.com

# Frontend Environment Variables (safe to expose)
VITE_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
VITE_POLYGON_API_KEY=your_polygon_api_key_here

# Firebase Configuration (Frontend - safe to expose)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=fxsentinel.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fxsentinel
VITE_FIREBASE_STORAGE_BUCKET=fxsentinel.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=92187574391
VITE_FIREBASE_APP_ID=1:92187574391:web:0b232b7fe364c639434672
VITE_FIREBASE_MEASUREMENT_ID=G-1QMRKVJD8C

# Stripe Configuration (for payments)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRODUCT_ID=prod_TG0y9LajTpBv6g
STRIPE_PRICE_ID=price_1SJUw5JNDWyJv8IpGZOmCT6j

# Subscription Configuration (Freemium Model)
FREE_ANALYSIS_LIMIT=15  # Per month for free users
PREMIUM_ANALYSIS_LIMIT=50  # Per day for premium users
PREMIUM_MONTHLY_PRICE=1499  # $14.99 in cents

# Frontend Stripe Key (safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Developer Access (comma-separated emails for bypassing payment)
DEVELOPER_EMAILS=your_email@example.com,developer@example.com

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/webhook.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/stripe-webhook",
      "dest": "/api/webhook.js"
    },
    {
      "src": "/api/health",
      "dest": "/api/webhook.js"
    },
    {
      "src": "/fxsentinel_logo_nobg.(png|webp)",
      "dest": "/fxsentinel_logo_nobg.$1"
    },
    {
      "src": "/fxsentinel_og.(png|webp)",
      "dest": "/fxsentinel_og.$1"
    },
    {
      "src": "/fxsentinelSmall.png",
      "dest": "/fxsentinelSmall.png"
    },
    {
      "src": "/logo-simple.svg",
      "dest": "/logo-simple.svg"
    },
    {
      "src": "/dashboard-preview.svg",
      "dest": "/dashboard-preview.svg"
    },
    {
      "src": "/logo.svg",
      "dest": "/logo.svg"
    },
    {
      "src": "/vite.svg",
      "dest": "/vite.svg"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
} 
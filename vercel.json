{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    }
  ],
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/robots.txt",
      "dest": "/api/robots",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/central-bank-documents.json",
      "dest": "/central-bank-documents.json",
      "headers": {
        "Cache-Control": "public, max-age=3600",
        "Content-Type": "application/json"
      }
    },
    {
      "src": "/documents/(.*\\.pdf)",
      "dest": "/documents/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Content-Type": "application/pdf"
      }
    },
    {
      "src": "/documents/(.*)",
      "dest": "/documents/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/fxsentinel_logo_nobg.(png|webp)",
      "dest": "/fxsentinel_logo_nobg.$1"
    },
    {
      "src": "/fxsentinel_og.(png|webp)",
      "dest": "/fxsentinel_og.$1"
    },
    {
      "src": "/fxsentinelSmall.png",
      "dest": "/fxsentinelSmall.png"
    },
    {
      "src": "/og-image.jpg",
      "dest": "/og-image.jpg"
    },
    {
      "src": "/twitter-image.jpg",
      "dest": "/twitter-image.jpg"
    },
    {
      "src": "/Landing_page_image.png",
      "dest": "/Landing_page_image.png"
    },
    {
      "src": "/logo-simple.svg",
      "dest": "/logo-simple.svg"
    },
    {
      "src": "/dashboard-preview.svg",
      "dest": "/dashboard-preview.svg"
    },
    {
      "src": "/logo.svg",
      "dest": "/logo.svg"
    },
    {
      "src": "/vite.svg",
      "dest": "/vite.svg"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "X-Robots-Tag": "index, follow",
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    }
  ]
} 
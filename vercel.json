{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/fxsentinel_logo_nobg.png",
      "dest": "/fxsentinel_logo_nobg.png"
    },
    {
      "src": "/fxsentinel_logo_nobg.webp",
      "dest": "/fxsentinel_logo_nobg.webp"
    },
    {
      "src": "/fxsentinel_og.png",
      "dest": "/fxsentinel_og.png"
    },
    {
      "src": "/fxsentinel_og.webp",
      "dest": "/fxsentinel_og.webp"
    },
    {
      "src": "/logo-simple.svg",
      "dest": "/logo-simple.svg"
    },
    {
      "src": "/dashboard-preview.svg",
      "dest": "/dashboard-preview.svg"
    },
    {
      "src": "/logo.svg",
      "dest": "/logo.svg"
    },
    {
      "src": "/vite.svg",
      "dest": "/vite.svg"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
} 
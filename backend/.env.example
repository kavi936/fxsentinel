UNIRATE_API_KEY=your_unirate_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Phase 1 — Gemini Google Search grounding before live-news GPT analysis (see docs/LIVE_NEWS_GEMINI_GROUNDING_PLAN.md)
# GEMINI_API_KEY=your_gemini_api_key_here
# LIVE_NEWS_GEMINI_GROUNDING_ENABLED=false
# LIVE_NEWS_GEMINI_GROUNDING_DEBUG=false
# LIVE_NEWS_GEMINI_GROUNDING_MODEL=gemini-2.5-flash
# LIVE_NEWS_GEMINI_GROUNDING_CACHE_TTL_SEC=1800
# LIVE_NEWS_GEMINI_GROUNDING_TIMEOUT_SEC=20

# V1 analysis brief + pipeline (default off — legacy product UX). Set true when reviewing spine work.
# ANALYSIS_V1_ENABLED=true
# Legacy alias (same effect if ANALYSIS_V1_ENABLED is unset):
# ANALYSIS_V1_SPINE_ENABLED=true

# Input layer — shared AnalysisContextPack in GPT prompts (Phase C: calendar wired in gpt_ai_analysis.py)
# Default off in production until staging sign-off.
# ANALYSIS_CONTEXT_PACK_ENABLED=true
# ANALYSIS_CONTEXT_PACK_INCLUDE_HOLISTIC=true
# ANALYSIS_CONTEXT_PACK_DEBUG=true

# OpenAI models — shared by calendar, live news, and legacy analyzers (see openai_model_config.py)
# High impact: CPI, NFP, FOMC, etc.  Standard: medium/low impact news and events.
# OPENAI_HIGH_IMPACT_MODEL=gpt-4o
# OPENAI_STANDARD_MODEL=gpt-4o-mini
# OPENAI_DEFAULT_MODEL=gpt-4o-mini
# OPENAI_HOLISTIC_MODEL=gpt-4o-mini
# HOLISTIC_SCAN_GPT_NARRATIVE_ENABLED=false

FLASK_ENV=development
FLASK_DEBUG=True

# Set to true to stop alerts from calling AI analysis (saves OpenAI/API credits)
# DISABLE_AI_FOR_ALERTS=true

# Worker news alerts: true = disabled (Unified path handles news; avoids duplicates)
# Set to false only if Unified path is not running (e.g. worker-only setup)
# DISABLE_WORKER_NEWS_ALERTS=true
# FXSentinel Environment Variables
# Copy this file to .env and fill in your actual values

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Stripe Configuration (PAYMENT PROCESSING)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_PRICE_ID=price_your_stripe_price_id_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Firebase Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_REALTIME_URL=https://your-project.firebaseio.com

# Telegram Bot Configuration (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=@YourBotUsername

# API Keys (Optional - for enhanced features)
ALPHA_VANTAGE_API_KEY_1=your_alpha_vantage_key_1
ALPHA_VANTAGE_API_KEY_2=your_alpha_vantage_key_2
ALPHA_VANTAGE_API_KEY_3=your_alpha_vantage_key_3
ALPHA_VANTAGE_API_KEY_4=your_alpha_vantage_key_4

UNIRATE_API_KEY=your_unirate_api_key_here

# Trial Configuration
TRIAL_DAYS=3

# Developer Configuration
DEVELOPER_EMAILS=kavi.cf412@gmail.com

# Security Configuration
FLASK_SECRET_KEY=your_flask_secret_key_here

# Domain Configuration (for webhooks)
DOMAIN_URL=https://fxsentinel.io

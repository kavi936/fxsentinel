# Dockerfile for FXSentinel Background Worker
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt /app/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy the application code
COPY . /app/

# Add cache-busting label to force rebuild
LABEL build_version="3.0.0"
LABEL build_date="2024-01-15"

# Debug: Show what's actually in the container
RUN echo "=== DEBUGGING WORKER BUILD CONTEXT ===" && \
    echo "Current directory: $(pwd)" && \
    echo "Files in root:" && \
    ls -la && \
    echo "Looking for worker_app.py:" && \
    find . -name "worker_app.py" -type f && \
    echo "Looking for backend:" && \
    find . -name "backend" -type d && \
    echo "Python files:" && \
    find . -name "*.py" | head -10

# Expose port
EXPOSE 8080

# Set environment variables for worker
ENV WORKER_MODE=true
ENV FLASK_ENV=production

# Start command - run the worker app
CMD ["python3", "backend/worker_app.py"]
